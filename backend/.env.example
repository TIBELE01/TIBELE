# =============================================================================
# TIBELE — Backend : variables d'environnement
# Copier ce fichier en `.env` et renseigner les valeurs. Ne JAMAIS commiter `.env`.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=4000
# Origines autorisées par CORS (liste blanche, séparées par des virgules)
CORS_ORIGINS=http://localhost:5173
# Nombre de proxys de confiance devant l'API (0 en local, 1 derrière un reverse proxy).
# Nécessaire pour que le rate-limiting par IP lise la vraie IP client.
TRUST_PROXY=0

# --- Base de données (Supabase PostgreSQL) -----------------------------------
# URL AVEC pooler (Supavisor, mode transaction, port 6543) : requêtes applicatives.
# (Pas de paramètre ?pgbouncer=true : inutile avec l'adaptateur pg de Prisma 7.)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# URL DIRECTE (port 5432) : migrations Prisma uniquement
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# --- Supabase Auth -----------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Clé service role : STRICTEMENT côté backend, jamais exposée au frontend
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
