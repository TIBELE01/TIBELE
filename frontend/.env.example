# =============================================================================
# TIBELE — Frontend : variables d'environnement
# Copier ce fichier en `.env` (ou `.env.local`) et renseigner les valeurs.
#
# ⚠️ Toute variable préfixée VITE_ est EMBARQUÉE dans le bundle JavaScript et
# donc PUBLIQUE. N'y mettez JAMAIS de secret. En particulier la clé « service
# role » de Supabase est réservée au backend : le build échoue si une variable
# VITE_* la mentionne.
# =============================================================================

# URL de base de l'API backend, sans « /api » ni slash final
VITE_API_URL=http://localhost:4000

# Supabase : URL du projet et clé PUBLIQUE « anon » (Settings > API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Lien de paiement Djamo pour les dons (facultatif : sans lien, le popup de dons est masqué)
VITE_DONATION_URL=
